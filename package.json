{
  "name": "repoggits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "test": "npm run test:e2e && npm run test:dev",
    "db:setup": "node --env-file=.env.local --import tsx scripts/setup.ts",
    "mail:outbox": "node --env-file=.env.local --import tsx scripts/outbox.ts",
    "mail:send": "node --env-file=.env.local --import tsx scripts/send-outbox.ts",
    "db:sample": "node --env-file=.env.local --import tsx scripts/seed-sample.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "three": "^0.180.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
