# Copy to .env.local and supply private credentials. Never publish that file.
# Deploying with Docker Compose instead? Copy deploy/docker.env.example to .env.

# --- Database ---------------------------------------------------------------
# Managed PostgreSQL (Neon and similar) — certificate verification stays on:
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# PostgreSQL on the same VPS — no TLS is negotiated over the loopback interface:
# DATABASE_URL=postgresql://repoggits:PASSWORD@127.0.0.1:5432/repoggits

# TLS handling. Leave unset to verify certificates for a remote host and to skip
# TLS for localhost. Values: disable, no-verify, require, verify-ca, verify-full.
# 'require' verifies the certificate here, which is stricter than libpq. Choose
# 'no-verify' only for a private network using a self-signed certificate.
# DATABASE_SSL=
# Private certificate authority for a self-hosted server presenting its own certificate:
# DATABASE_CA_CERT_FILE=/etc/repoggits/db-ca.crt
# Pooled connections held by this process. Raise only alongside the server's max_connections.
# DATABASE_POOL_MAX=5

# --- Application ------------------------------------------------------------
# The exact public browser origin: scheme, host, and port, with no trailing slash.
# State-changing requests are rejected when it does not match, and session
# cookies are marked Secure only when it starts with https.
APP_ORIGIN=http://localhost:3000
# Port the Node process listens on. The reverse proxy forwards to it.
# PORT=3000

# --- Mail -------------------------------------------------------------------
MAIL_MODE=outbox
# To send mail, use MAIL_MODE=smtp and configure the values below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Files and accounts -----------------------------------------------------
# Upload validation runs inside the application; no scanner service is required.
# Optional; otherwise a server-only random signing secret is stored in the database.
DOWNLOAD_SECRET=

# Temporarily allow accounts without email verification. Set true to restore it.
EMAIL_VERIFICATION_REQUIRED=false

# Dev-only: pins the registration/verify OTP to this value so it can be entered without
# reading real mail. Never set this in production — it lets anyone verify any account.
# DEV_FIXED_OTP=

# --- Optional: real-delivery OTP tests (npm run test:otp) -------------------
# testmail.app only receives — sending still goes through the SMTP settings above.
# TESTMAIL_NAMESPACE=
# TESTMAIL_APIKEY=