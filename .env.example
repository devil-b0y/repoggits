# Copy to .env.local and supply private credentials. Never publish that file.
# Deploying with Docker Compose instead? Copy deploy/docker.env.example to .env.

# --- Database ---------------------------------------------------------------
# Managed PostgreSQL (Neon and similar) — certificate verification stays on:
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# PostgreSQL on the same VPS — no TLS is negotiated over the loopback interface:
# DATABASE_URL=postgresql://repoggits:PASSWORD@127.0.0.1:5432/repoggits

# TLS handling. Leave unset to verify certificates for a remote host and to skip
# TLS for localhost. Values: disable, no-verify, require, verify-ca, verify-full.
# 'require' verifies the certificate here, which is stricter than libpq. Choose
# 'no-verify' only for a private network using a self-signed certificate.
# DATABASE_SSL=
# Private certificate authority for a self-hosted server presenting its own certificate:
# DATABASE_CA_CERT_FILE=/etc/repoggits/db-ca.crt
# Pooled connections held by this process. Raise only alongside the server's max_connections.
# DATABASE_POOL_MAX=5

# --- Moving to another database (npm run db:transfer) ------------------------
# Set these only while moving to a new PostgreSQL server, for example Amazon RDS,
# Google Cloud SQL, or Azure. Afterwards move the values into the DATABASE_*
# settings above and delete these lines. See "Moving to another database" in
# docs/DEPLOYMENT.md.
# TARGET_DATABASE_URL=postgresql://USER:PASSWORD@NEW-HOST:5432/DATABASE?sslmode=require
# TARGET_DATABASE_SSL=verify-full
# TARGET_DATABASE_CA_CERT_FILE=/path/to/provider-ca.pem
# Schema created on the new server. Defaults to the one used here.
# TARGET_DATABASE_SCHEMA=

# --- Data encryption ---------------------------------------------------------
# Required. Email addresses, private profile details, queued emails, and uploaded
# files are encrypted with this key before they reach the database. 32 random bytes
# in base64:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back it up outside the database: without this exact value that data cannot be read.
# Every server that shares the database needs the same key.
DATA_ENCRYPTION_KEY=

# --- Application ------------------------------------------------------------
# The exact public browser origin: scheme, host, and port, with no trailing slash.
# State-changing requests are rejected when it does not match, and session
# cookies are marked Secure only when it starts with https.
APP_ORIGIN=http://localhost:3000
# Gemini writes optional project suggestions; keys are server-only.
GEMINI_API_KEY=
# Optional comma-separated backup keys. Duplicates are removed; at most 3 keys
# are tried per request. Keys in the same Google project may share quotas.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Port the Node process listens on. The reverse proxy forwards to it.
# PORT=3000
# Optional CDN for the build's /_next/static files, e.g. https://cdn.your-domain.edu. It is
# written into the build, so set it before `npm run build` and keep it set when the app runs.
# ASSET_PREFIX=

# --- Tracking and the admin panel -------------------------------------------
# Reverse proxies in front of the app that append to X-Forwarded-For: 0 to 5, default 0.
# `next start` only fills X-Forwarded-For from the socket when a request has none, so with
# no proxy a client can send its own header and forge the IP address the admin panel shows.
# Behind the bundled nginx (deploy/nginx.conf) or Caddy (docker compose --profile tls), set 1.
# Never set more hops than there are proxies: each extra one lets a client pick its address.
# TRUSTED_PROXY_HOPS=0
# Seconds after its last heartbeat that a browser still counts as online: 60 to 3600,
# default 120. The browser sends a heartbeat every 45 seconds while its tab is visible.
# PRESENCE_TIMEOUT_SECONDS=120

# --- Mail -------------------------------------------------------------------
MAIL_MODE=outbox
# To send mail, use MAIL_MODE=smtp or MAIL_MODE=azure and configure the matching values below.
# MAIL_FROM is the sender address; with Azure it must belong to a domain connected to the resource,
# e.g. DoNotReply@xxxxxxxx.azurecomm.net.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Azure Communication Services -> your resource -> Settings -> Keys -> Connection string.
AZURE_COMMUNICATION_CONNECTION_STRING=

# --- Files and accounts -----------------------------------------------------
# Upload validation runs inside the application; no scanner service is required.
# Optional; otherwise a server-only random signing secret is stored in the database.
DOWNLOAD_SECRET=

# Temporarily allow accounts without email verification. Set true to restore it.
EMAIL_VERIFICATION_REQUIRED=false

# Dev-only: pins the registration/verify OTP to this value so it can be entered without
# reading real mail. Never set this in production — it lets anyone verify any account.
# DEV_FIXED_OTP=

# --- Optional: real-delivery OTP tests (npm run test:otp) -------------------
# testmail.app only receives — sending still goes through the SMTP settings above.
# TESTMAIL_NAMESPACE=
# TESTMAIL_APIKEY=
