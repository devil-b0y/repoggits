# Copy to .env in the repository root before running docker compose.
# Compose reads this file for both variable substitution and the application's
# own settings. Keep it private: chmod 600 .env

# --- Database (container) ---------------------------------------------------
# Used to initialise the postgres service and to build the application's
# DATABASE_URL. Generate a long random value, for example:
#   openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=repoggits
POSTGRES_DB=repoggits

# --- Data encryption ---------------------------------------------------------
# Required. Encrypts email addresses, private profile details, queued emails, and
# uploaded files before they are stored. Generate once with: openssl rand -base64 32
# Back it up away from database dumps: without this exact key that data is lost.
DATA_ENCRYPTION_KEY=

# --- Public address ---------------------------------------------------------
# The exact origin browsers use, with no trailing slash. State-changing requests
# are refused when this does not match, and session cookies are marked Secure
# only when it starts with https.
APP_ORIGIN=https://projects.your-domain.edu

# Optional Gemini submission assistant. Keep these keys private; only the Node
# server uses them. Up to three distinct keys are tried on provider failures.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Only for the optional bundled Caddy proxy (docker compose --profile tls).
# The hostname alone, without a scheme. It must already resolve to this server.
APP_DOMAIN=projects.your-domain.edu

# --- Mail -------------------------------------------------------------------
# outbox stores messages in the database without sending them. Switch to smtp
# or azure so password resets and review notifications actually reach people.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# For MAIL_MODE=azure: Communication Services resource -> Settings -> Keys.
AZURE_COMMUNICATION_CONNECTION_STRING=

# --- Optional ---------------------------------------------------------------
# Signing key for expiring source-download links. Leave blank to have one
# generated and stored in the database on first use.
DOWNLOAD_SECRET=
EMAIL_VERIFICATION_REQUIRED=false

# Gemini fills in project details from a student's description on the submit page.
# Leave blank to disable generation; the form still works manually.
# Prompts (which may include team names and roll numbers) are sent to Google.
GEMINI_API_KEY=
# Optional comma-separated backup keys, tried in order when a key hits its quota.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
